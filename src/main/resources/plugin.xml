<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plugin SYSTEM "../plugin.dtd">
<plugin
    name="dtbook-preptools"
    description="A plugin that allows simple marking up of dtbook-files as a preparatory step to translation to Braille"
    version="${project.version}"
    vendor="SBS"
    class="ch.sbs.plugin.preptools.PrepToolsPlugin">
  <runtime>
    <library name="lib/dtbook-preptools-${project.version}.jar"/>
    <library name="lib/wordhierarchy-${wordhierarchy.version}.jar"/>
  </runtime>
  <extension type="WorkspaceAccess" class="ch.sbs.plugin.preptools.PrepToolsPluginExtension"/>
  <extension type="componentsValidator" class="ch.sbs.plugin.preptools.PrepToolsValidatorPluginExtension"/>
  
  <view id="dtbook-preptoolsviewid" initialSide="WEST" initialRow="0"/>
  <toolbar id="dtbook-preptoolstoolbarid" initialSide="NORTH" initialRow="1"/>
</plugin>
		
